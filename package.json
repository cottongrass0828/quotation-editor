{
  "name": "quotation-editor",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "page": "gh-pages -d dist",
    "bump-version": "node scripts/bump-version.js",
    "deploy": "npm run bump-version && npm run build && npm run page",
    "build:android": "cross-env CAP_BUILD=1 vite build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "html2canvas": "^1.4.1",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "json": "^11.0.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.5"
  }
}
